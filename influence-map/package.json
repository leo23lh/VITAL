{
  "name": "influence-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local network graph viewer for public figures researched with Claude Code",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "scorecard": "node scripts/scorecard.mjs",
    "evidence": "node scripts/evidence-report.mjs",
    "predict": "node scripts/predict.mjs",
    "fec": "node scripts/fec-import.mjs",
    "tune-pull": "node scripts/tune-pull.mjs",
    "freshness": "node scripts/freshness.mjs",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
